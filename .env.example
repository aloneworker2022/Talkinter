# Copy to .env and adjust, then:  set -a && . ./.env && set +a && npm start

# ---- Server ----
HOST=0.0.0.0
PORT=8787
# Optional shared password. If set, the web UI asks for it once.
# AUTH_TOKEN=change-me

# ---- Choose how Talkinter reaches your agent ----
# mock | command | http
AGENT_ADAPTER=mock

# RECOMMENDED for Hermes: run `hermes gateway` and use the http adapter below.
# `hermes` on its own is a full-screen TUI and can't be driven through pipes.
#   1) set API_SERVER_KEY in your Hermes config
#   2) run:  hermes gateway     (serves OpenAI API on 127.0.0.1:8642)
#   3) uncomment the AGENT_HTTP_* block near the bottom of this file.

# ---- command adapter: wrap your Hermes CLI (replaces the SSH terminal) ----
# You just type `hermes` to enter chat mode? Use persistent mode:
# AGENT_ADAPTER=command
# AGENT_CMD=hermes
# AGENT_CMD_MODE=persistent        # oneshot | persistent
# AGENT_CMD_IDLE_MS=900            # silence (after first output) = reply done
# AGENT_CMD_WARMUP_MS=20000        # max wait for the first output token
# AGENT_CMD_PTY=1                  # only if hermes needs a real TTY
# AGENT_CMD_CWD=/path/to/hermes
#
# One-shot CLI instead? Use {message} as a placeholder (or omit it for stdin):
# AGENT_CMD=hermes chat --prompt {message}
# AGENT_CMD_MODE=oneshot

# ---- http adapter: Hermes gateway (or any OpenAI-compatible endpoint) ----
# For Hermes, uncomment these (AGENT_HTTP_KEY must match Hermes' API_SERVER_KEY):
# AGENT_ADAPTER=http
# AGENT_HTTP_URL=http://localhost:8642/v1/chat/completions
# AGENT_HTTP_KEY=my-secret
# AGENT_HTTP_MODEL=hermes
# AGENT_HTTP_SYSTEM=
#
# (Other OpenAI-compatible servers work too, e.g. Ollama:)
# AGENT_HTTP_URL=http://localhost:11434/v1/chat/completions

# ---- Branding ----
APP_TITLE=Talkinter
APP_SUBTITLE=Hermes agent
